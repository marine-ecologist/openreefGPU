# Worker-only update; keep the verified native stack and patched OpenReef unchanged.
FROM ghcr.io/marine-ecologist/openreef-gpu:0.6.5-gpu.10-volume.2
RUN colmap feature_extractor --help 2>&1 | grep -q single_camera_per_folder
COPY worker/ /opt/openreefgpu/worker/
COPY versions.json /opt/openreefgpu/versions.json
WORKDIR /opt/openreefgpu
CMD ["python3", "-m", "worker.handler"]
